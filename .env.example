# URL del back (nexorafit-back) para el proxy /api/v1 (next.config.ts). En local, con
# `make api` en ese repo: http://localhost:8000.
API_URL=http://localhost:8000

# Hasta el lanzamiento, noindex en todos los entornos (guía front §9.5). Se cambia a "true"
# el día del lanzamiento.
NEXT_PUBLIC_INDEXABLE=false
